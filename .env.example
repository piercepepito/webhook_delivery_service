# Template for the environment. Copy to .env and fill in real values.
#
#     cp .env.example .env

# PostgreSQL connection string.
# The driver must be psycopg 3, so the scheme is postgresql+psycopg://
# (not postgresql:// and not postgresql+psycopg2://).
#
# Supabase, via the session pooler:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Fernet key used to encrypt signing secrets at rest.
# 44 characters, URL-safe base64, ending in '='.
#
# Generate it ONCE, by hand:
#     python -m encryption.key_generation
#
# Never generate this at application startup: a new key on every restart would
# make every stored secret permanently undecryptable.
ENCRYPTION_KEY=

# development | production
#
# 'development' permits http://localhost and http://127.0.0.1 as subscription
# URLs, so a local receiver can be used for testing. Any other value requires
# HTTPS for every destination URL.
ENVIRONMENT=development

# Celery broker and result backend.
#
# NOTE: worker/celery_app.py currently hardcodes redis://localhost:6379/0.
# This variable is not read by the code yet.
#
#     running locally:  redis://localhost:6379/0
#     inside compose:   redis://redis:6379/0

REDIS_URL=redis://localhost:6379/0
